FROM php:7.4-fpm

# System dependencies
RUN apt-get update && apt-get install -y \
    curl \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    zip \
    unzip \
    wkhtmltopdf \
    libxrender1 \
    libxext6 \
    libfontconfig1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Configure GD with freetype + jpeg support
RUN docker-php-ext-configure gd \
    --with-freetype \
    --with-jpeg

# Install core PHP extensions
RUN docker-php-ext-install \
    pdo \
    pdo_mysql \
    mbstring \
    exif \
    pcntl \
    bcmath \
    gd \
    zip \
    xml \
    opcache \
    tokenizer \
    ctype \
    json


# Install Composer 2.2 (last version supporting PHP 7.4)
COPY --from=composer:2.2 /usr/bin/composer /usr/bin/composer

# PHP config: opcache
RUN echo "opcache.enable=1"                    >> /usr/local/etc/php/conf.d/opcache.ini \
 && echo "opcache.memory_consumption=128"      >> /usr/local/etc/php/conf.d/opcache.ini \
 && echo "opcache.max_accelerated_files=10000" >> /usr/local/etc/php/conf.d/opcache.ini \
 && echo "opcache.validate_timestamps=1"       >> /usr/local/etc/php/conf.d/opcache.ini

# PHP config: upload/memory limits
RUN echo "upload_max_filesize=50M" >> /usr/local/etc/php/conf.d/limits.ini \
 && echo "post_max_size=50M"       >> /usr/local/etc/php/conf.d/limits.ini \
 && echo "memory_limit=256M"       >> /usr/local/etc/php/conf.d/limits.ini \
 && echo "max_execution_time=120"  >> /usr/local/etc/php/conf.d/limits.ini

WORKDIR /var/www/html

# Ensure wkhtmltopdf is accessible at the path Laravel snappy expects
RUN ln -sf "$(which wkhtmltopdf)" /usr/local/bin/wkhtmltopdf 2>/dev/null || true

COPY docker/offline/php/start-app.sh /usr/local/bin/start-app.sh
RUN sed -i 's/\r$//' /usr/local/bin/start-app.sh \
 && chmod +x /usr/local/bin/start-app.sh

EXPOSE 9000

CMD ["php-fpm"]
