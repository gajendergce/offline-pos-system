# Normalize line endings: always store as LF, checkout as LF on all platforms
* text=auto eol=lf

# Shell scripts must always be LF
*.sh text eol=lf

# Batch/Windows scripts use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Dockerfiles and YAML always LF
Dockerfile* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
